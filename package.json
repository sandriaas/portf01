{
  "name": "delveblue-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "cf:build": "turbo run cf:build",
    "cf:deploy": "turbo run cf:deploy",
    "cf:deploy:main": "npm run cf:deploy -w @delveblue/main",
    "cf:deploy:gallery": "npm run cf:deploy -w @delveblue/gallery",
    "cf:deploy:router": "npm run deploy -w @delveblue/router",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
